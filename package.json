{
  "name": "dreamscape",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name revemieux",
    "db:migrate:local": "wrangler d1 migrations apply revemieux-production --local",
    "db:seed": "wrangler d1 execute revemieux-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "prepare:assets": "tailwindcss -i ./src/tailwind.css -o ./public/static/tailwind.css --minify && node scripts/prepare-assets.mjs",
    "prebuild": "npm run prepare:assets",
    "predev": "npm run prepare:assets"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "chart.js": "4.4.0",
    "tailwindcss": "3.4.19",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
